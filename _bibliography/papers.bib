@unpublished{CMBiellipticPicardCurves,
  abbr = {IMU Talk},
  author = {Hilel Garmi},
  title = {Galois Groups of Trinomials with Small Coefficients},
  year = {2026},
  extended_abstract = {imu_extended_abstract.pdf},
  selected = {true},
  abstract = {Hilbert's Irreducibility Theorem (1892) implies that the Galois group over the rationals of "almost" any polynomial $f$ with rational coefficients is $S_n$.
However, it is very difficult to find explicit examples of polynomials with Galois group $S_n$.
To our knowledge, the only previously known explicit example with bounded integer coefficients is the family of trinomials $x^n - x - 1$, which was proven by Nart and Vila (1979).
We proved a few new families of polynomials with bounded integer coefficients to have Galois group $S_n$ for any $n$.

In this talk, I will sketch the proof of the known result of Nart and Vila, before presenting the approach we used to prove our new results.
To illustrate our method, I will use the example of the family $x^n - 2x + 1$, which factors as the product of $x-1$ and the generalized Fibonacci polynomial $x^{n-1} + x^{n-2} + \cdots + x - 1$, which was shown to have Galois group $S_{n-1}$ for odd values of $n$ by Martin (2004) and for even values of $n$ by us (2026).
Along the way, I will define inertia groups, use properties of the $p$-adic numbers, and give a taste of Grothendieck's Galois theory.}
}

@unpublished{CMBiellipticPicardCurves,
  abbr = {Undergrad Research},
  author = {Hilel Garmi},
  title = {Fields Generated by a Classifying Invariant of CM Bielliptic Picard Curves},
  year = {2024},
  pdf = {CM_Bielliptic_Picard_curves.pdf},
  selected = {true},
  abstract = {We calculate the fields generated by certain curves of the kind $C \colon y^3 = x^4 + ax^2 + b$ in the following way:
    The endomorphism ring of the associated Prym variety $P$ of this kind of curves admits an embedding of a quaternion order $\mathcal{O}$, and we are interested in the cases where the centralizer of $\mathcal{O}$ in $\operatorname{End}(P)$ is a maximal order of an imaginary quadratic field.
    We characterize the imaginary quadratic fields, $K$, whose maximal order is the centralizer of $\mathcal{O}$ in $\operatorname{End}(P)$ for some $C$ of the above kind, and we calculated the field generated over $K$ by a classifying invariant of the curves of the above kind in terms of class field theory.}
}

